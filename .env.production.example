# ===== Rejim =====
# domain — o'z domeningiz, Caddy 80/443'da ishlaydi va HTTPS'ni o'zi oladi
# proxy  — serverda boshqa narsalar (pm2/nginx) bor; web faqat 127.0.0.1:WEB_PORT'da,
#          HTTPS'ni mavjud proxy beradi. Standart portlar band bo'lganda shu.
# tunnel — Cloudflare Tunnel, hech qanday port ochilmaydi
DEPLOY_MODE=proxy
# domain rejimida: domen nomi (https:// siz). proxy/tunnel rejimida: :80
SITE_ADDRESS=:80
# Mini App manzili (bot menyu tugmasi shu manzilni ochadi) — HTTPS domeningiz
WEBAPP_URL=https://app.example.uz
# proxy rejimida: web faqat shu portda (127.0.0.1). pm2 portlariga urilmaydigan yuqori port tanlang.
WEB_PORT=8791
# Faqat tunnel rejimida: Cloudflare Zero Trust -> Tunnels -> token
CLOUDFLARE_TUNNEL_TOKEN=

# ===== Telegram =====
BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Admin bo'limi ko'rinadigan Telegram ID'lar (vergul bilan)
ADMIN_TELEGRAM_IDS=

# ===== Maxfiy kalitlar (init-env.sh tasodifiy to'ldiradi) =====
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
JWT_SECRET=__JWT_SECRET__
ADMIN_SECRET=__ADMIN_SECRET__
INTERNAL_API_TOKEN=__INTERNAL_API_TOKEN__
# ❗ Telegram sessiyalari shu kalit bilan shifrlanadi. Yo'qolsa — barcha akkauntlar qayta ulanadi.
# Lokal bazani ko'chirsangiz, eski .env dagi qiymatni qo'ying.
SESSION_ENCRYPTION_KEY=__SESSION_ENCRYPTION_KEY__

# ===== Boshqa =====
DEFAULT_TIMEZONE=Asia/Tashkent
BACKUP_KEEP_DAYS=14
# To'lov rekvizitlari endi Admin -> Sozlamalar'da kiritiladi (bu qator faqat zaxira).
PAYMENT_INSTRUCTIONS=

# ===== AI (OpenAI) =====
# platform.openai.com -> API keys. Bo'sh bo'lsa AI xizmatlari "sozlanmagan" ko'rinadi.
OPENAI_API_KEY=
# Standart model (Admin -> AI bo'limida o'zgartiriladi)
OPENAI_MODEL=gpt-4o-mini
