DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/userbots
REDIS_URL=redis://redis:6379

BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

SESSION_ENCRYPTION_KEY=
JWT_SECRET=
# Bot admin API'ga shu parol bilan "admin" nomidan kiradi
ADMIN_SECRET=
# Bot -> API ichki kaliti (openssl rand -hex 32)
INTERNAL_API_TOKEN=
# Botda Admin panel ko'rinadigan Telegram ID'lar (vergul bilan)
ADMIN_TELEGRAM_IDS=
# Balans to'ldirishda foydalanuvchiga ko'rsatiladi (karta raqami va h.k.)
PAYMENT_INSTRUCTIONS=
DEFAULT_TIMEZONE=Asia/Tashkent

MOCK_TELEGRAM=true

# ===== AI (OpenAI) =====
# platform.openai.com -> API keys. Bo'sh bo'lsa AI xizmatlari "sozlanmagan" ko'rinadi.
OPENAI_API_KEY=
# Standart model (Admin -> AI bo'limida o'zgartiriladi)
OPENAI_MODEL=gpt-4o-mini
